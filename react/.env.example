# Your Syncfusion license key for package version 34.1.29, React platform.
# Generate at https://www.syncfusion.com/account/downloads.
VITE_SYNCFUSION_LICENSE_KEY=

# API base URL. Empty (default) -> relative /api/* requests routed through
# vite.config.ts's dev proxy (dev) or the deployed reverse proxy (prod).
# Set to an absolute URL (e.g. http://localhost:5269) to call the API
# directly (requires the backend's CORS policy to allow the Vite origin).
VITE_API_BASE_URL=
