<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- These integration tests run against the REAL local PostgreSQL database (no in-memory/fake
         provider) via the Api project's user-secrets connection strings. -->
    <UserSecretsId>f12479f5-0cf2-4239-84ff-14d3728a28d1</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Api\LogisticsFleetOperations.Api.csproj" />
    <ProjectReference Include="..\..\src\Application\LogisticsFleetOperations.Application.csproj" />
    <ProjectReference Include="..\..\src\Domain\LogisticsFleetOperations.Domain.csproj" />
    <ProjectReference Include="..\..\src\Infrastructure\LogisticsFleetOperations.Infrastructure.csproj" />
  </ItemGroup>

</Project>
